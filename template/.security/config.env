# repo-sentinel configuration — shared by the hooks and CI.

# Tool images: pinned by tag + digest (the same image runs even if the tag is moved).
# When updating: pick a release at least 7 days old and verify the digest:
#   docker buildx imagetools inspect <image:tag>
SEC_IMG_GITLEAKS="ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"
SEC_IMG_OSV="ghcr.io/google/osv-scanner:v2.7.0@sha256:4f3b7e2c64b9d38a5febc5a7e4a3dfef1d1362f726dea7a2ef4762b46469fcd0"
SEC_IMG_TRIVY="aquasec/trivy:0.76.0@sha256:2416d1f74045b57274df1a340eee6b510cacd73c66a6ccb8da092b117eb7d222"
SEC_IMG_SEMGREP="semgrep/semgrep:1.181.0@sha256:81474464c1f07483ba0682a44787fd93c91397419762a04abe2bafaae396304b"
SEC_IMG_ACTIONLINT="rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667"
SEC_IMG_ZIZMOR="ghcr.io/zizmorcore/zizmor:1.31.1@sha256:42d409dbb851d4c5d35a058cf042b828bea1e3f2884378c526eb0974780e18d9"
SEC_IMG_JQ="ghcr.io/jqlang/jq:1.8.2@sha256:b9c68867e5766576263a222e91db3de422d802069c7af70440e667a95344e486"

# Dependencies: vulnerabilities INTRODUCED by this change with a CVSS score at or above this value block.
# Malicious package (OSV MAL-) records always block, regardless of score.
SEC_DEPS_BLOCK_CVSS=7.0

# IaC / Dockerfile: blocking severity levels (trivy config).
SEC_IAC_SEVERITY="HIGH,CRITICAL"

# SAST: Semgrep rule packs (cached daily) and the blocking severity.
#   auto = based on the languages of the changed files (p/python, p/javascript, p/java, p/golang, p/csharp...)
#   or space-separated registry packs: "p/default" | "p/python p/owasp-top-ten"
# If the repo has a .semgrep/ directory, the custom rules in it run too.
SEC_SAST_CONFIG="auto"
SEC_SAST_BLOCK_SEVERITY="ERROR"
# By default Semgrep skips directories named test/ and tests/ (__tests__, *.spec.ts, *.test.ts,
# e2e/ are scanned). true: these directories are scanned too. A .semgrepignore in the repo takes precedence.
SEC_SAST_SCAN_TESTS=false

# Workflow: lowest blocking severity for zizmor (low | medium | high).
SEC_WORKFLOW_MIN_SEVERITY="high"

# Paths that no check looks at (ERE).
SEC_EXCLUDE_REGEX='(^|/)(node_modules|vendor|dist|build|\.venv|venv|__pycache__|\.next|coverage)/'

# If a tool cannot run (Docker down, no network): auto = fail in CI, warn locally.
SEC_FAIL_ON_TOOL_ERROR="${SEC_FAIL_ON_TOOL_ERROR:-auto}"
